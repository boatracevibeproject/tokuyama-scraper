{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bvp/tokuyama-scraper",
    "description": "BVP Tokuyama Scraper：ボートレース徳山の公式サイトからデータを取得する PHP ライブラリ（scraper-stadiums へ移行） | Archived: moved to scraper-stadiums",
    "keywords": [
        "boatrace",
        "library",
        "scraper"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "shimomo",
            "email": "bvp@shimomo.net"
        }
    ],
    "support": {
        "issues": "https://github.com/boatracevibeproject/tokuyama-scraper/issues",
        "source": "https://github.com/boatracevibeproject/tokuyama-scraper"
    },
    "require": {
        "php": "^8.2",
        "bvp/scraper-core": "^5.3",
        "nesbot/carbon": "^2.63 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1 || ^11.1 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "BVP\\TokuyamaScraper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BVP\\TokuyamaScraper\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
